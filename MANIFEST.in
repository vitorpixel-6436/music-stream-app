# MANIFEST.in
# Specifies which files to include in the package distribution

# Documentation
include README.md
include LICENSE
include steam_ui/README.md

# Templates
recursive-include steam_ui/templates *.html
recursive-include steam_ui/templates *.txt

# Static files
recursive-include steam_ui/static *.css
recursive-include steam_ui/static *.js
recursive-include steam_ui/static *.svg
recursive-include steam_ui/static *.png
recursive-include steam_ui/static *.jpg
recursive-include steam_ui/static *.woff
recursive-include steam_ui/static *.woff2

# Exclude compiled Python files
global-exclude *.pyc
global-exclude *.pyo
global-exclude __pycache__
global-exclude .DS_Store
